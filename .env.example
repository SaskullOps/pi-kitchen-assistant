# Copy to .env and fill in. Placeholders only; never commit the real file.
# This file is read by `docker compose` AND sourced by bash (scripts/*.sh): quote values that contain spaces.
# Placeholders starting with "change-me" / "000000000:" make the helper scripts refuse to run until replaced.

# ============================================================================
# Telegram
# ============================================================================
# Token from @BotFather (/newbot)
TELEGRAM_KITCHEN_BOT_TOKEN=000000000:replace-with-your-bot-token
# Comma-separated numeric chat IDs allowed to talk to the bot (private chat and/or group). Other chats are dropped.
KITCHEN_ALLOWED_CHAT_IDS=123456789
# Chat IDs that receive scheduled messages (weekly proposal, expiry alerts...). Usually one group or the same list.
# REQUIRED by the generator. Group IDs are negative, e.g. -123456789.
KITCHEN_CHAT_IDS=123456789
# Shared secret sent by the bridge in the X-Kitchen-Secret header (generate: openssl rand -hex 24)
KITCHEN_WEBHOOK_SECRET=change-me

# ============================================================================
# API credentials (stored by scripts/create_credentials.sh as n8n credentials; also used by helper scripts)
# ============================================================================
# Grocy: Manage API keys -> Add
GROCY_API_KEY=change-me
# Tandoor token (see docs/SETUP.md step 4)
TANDOOR_API_TOKEN=change-me
# OpenRouter (or any OpenAI-compatible endpoint, see OPENROUTER_API_URL)
OPENROUTER_API_KEY=change-me

# ============================================================================
# docker-compose.example.yml
# ============================================================================
TANDOOR_DB_PASSWORD=change-me
# Django secret key (generate: openssl rand -hex 32)
TANDOOR_SECRET_KEY=change-me
# Interface the published ports bind to. 127.0.0.1 = only this machine. Use your LAN/VPN IP to reach the UIs remotely.
BIND_ADDR=127.0.0.1
GROCY_PORT=9283
TANDOOR_PORT=8095
N8N_PORT=5678
# Origin you open Tandoor from, used for CSRF checks (must match the URL in your browser)
TANDOOR_ORIGIN=http://localhost:8095
# Tandoor ALLOWED_HOSTS; restrict to your hostname when exposed beyond localhost
TANDOOR_ALLOWED_HOSTS=*
# Base URL n8n uses to build webhook links. Keep the default unless you publish n8n behind a reverse proxy.
N8N_WEBHOOK_URL=http://localhost:5678/
# false allows logging in to n8n over plain http; set to true behind HTTPS
N8N_SECURE_COOKIE=false
# Where the bridge stores its Telegram update offset inside its container (already mounted at /data)
#BRIDGE_OFFSET_FILE=/data/offset

# ============================================================================
# Generator settings (scripts/build.sh, generator/*.py) - all optional except KITCHEN_CHAT_IDS
# ============================================================================
# IANA timezone for n8n schedules (Friday proposal, 23:30 consumption...). Also used for the containers.
KITCHEN_TIMEZONE=Europe/Madrid
# Name shown for the "personal breakfasts/snacks" block (one person who eats their own breakfast/snack plan)
KITCHEN_PERSONAL_NAME="Person A"
# Free-text household/kitchen description given to the LLM planner (equipment, tastes). Defaults to a generic one.
#KITCHEN_HOUSEHOLD="Household: ..."
# Where ingredients should be easy to find (used in the new-recipe prompt)
#KITCHEN_LOCALE_HINT="supermarkets and markets near the household"
# Browser-facing Tandoor URL used for the session-plan link in the batch guide (empty = no link)
TANDOOR_PUBLIC_URL=
# LLM models (OpenRouter ids). MODEL = receipts/intents/proposals, GUIDE_MODEL = batch session plan and recipe enrichment
KITCHEN_MODEL=google/gemini-3.5-flash-lite
KITCHEN_GUIDE_MODEL=google/gemini-3.8-flash
#ENRICH_MODEL=google/gemini-3.8-flash
# Any OpenAI-compatible chat completions endpoint with JSON-schema support
#OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Webhook paths served by n8n (the bridge posts to /webhook/<KITCHEN_WEBHOOK_PATH>)
KITCHEN_WEBHOOK_PATH=kitchen-telegram
KITCHEN_PLANNER_HOOK_PATH=kitchen-job-planner
# API roots as seen from inside the docker network (what n8n calls)
GROCY_API_URL=http://grocy:80/api
TANDOOR_API_URL=http://tandoor:80/api
# API roots as seen from the machine running the helper scripts (seed_master_data.py, recipes/*.py)
GROCY_BASE_URL=http://localhost:9283
TANDOOR_BASE_URL=http://localhost:8095

# ============================================================================
# n8n credentials referenced by the generated workflows (created by scripts/create_credentials.sh)
# Keep the defaults unless you already have credentials with other ids.
# ============================================================================
N8N_CRED_TELEGRAM_ID=KitchenTgBot0001
N8N_CRED_TELEGRAM_NAME="Kitchen bot"
N8N_CRED_GROCY_ID=KitchenGrocy0001
N8N_CRED_GROCY_NAME="Grocy API"
N8N_CRED_TANDOOR_ID=KitchenTandoor01
N8N_CRED_TANDOOR_NAME="Tandoor API"
N8N_CRED_OPENROUTER_ID=KitchenORouter01
N8N_CRED_OPENROUTER_NAME="OpenRouter"
N8N_CRED_BRIDGE_ID=KitchenBridge001
N8N_CRED_BRIDGE_NAME="Kitchen bridge secret"

# ============================================================================
# Helper scripts (optional)
# ============================================================================
#N8N_CONTAINER=n8n
#N8N_URL=http://localhost:5678
#N8N_SERVICE=n8n
# harness.sh: chat id to simulate (default: first KITCHEN_ALLOWED_CHAT_IDS), sudo prefix for reading n8n's SQLite
# (set HARNESS_SUDO= empty if your user can read the docker volume), explicit path to the SQLite file
#HARNESS_CHAT_ID=123456789
#HARNESS_SUDO=sudo
#N8N_SQLITE=/var/lib/docker/volumes/<project>_n8n-data/_data/database.sqlite
#HARNESS_WORKFLOW_ID=KitchenRouter001
# enrich_recipes.py cron/hourly run uses TANDOOR_BASE_URL, TANDOOR_API_TOKEN, OPENROUTER_API_KEY and ENRICH_MODEL
